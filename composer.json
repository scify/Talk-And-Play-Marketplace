{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2.0",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*",
        "ext-zip": "*",
        "doctrine/dbal": "^3.10",
        "guzzlehttp/guzzle": "^7.15.3",
        "laravel/fortify": "^1.39",
        "laravel/framework": "^12.69",
        "laravel/tinker": "^2.11",
        "scify/laravel-cookie-guard": "^4.1",
        "sentry/sentry-laravel": "^4.27.0",
        "spatie/laravel-sitemap": "^7.4",
        "symfony/http-client": "^6.4",
        "symfony/mailgun-mailer": "^6.4"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.16",
        "fakerphp/faker": "^1.9.1",
        "larastan/larastan": "^3",
        "laravel/pint": "^1.30",
        "laravel/sail": "^1.67.0",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest-plugin-laravel": "^3.1",
        "spatie/laravel-ignition": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "app/Utils/UrlHelpers.php"
        ]
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "setup": [
            "Composer\\Config::disableProcessTimeout",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@composer install",
            "@php -r \"require 'vendor/autoload.php'; empty(Dotenv\\Dotenv::parse(file_get_contents('.env'))['APP_KEY'] ?? null) && exit(pclose(popen(escapeshellarg(PHP_BINARY) . ' artisan key:generate --ansi', 'w')));\"",
            "@php -r \"is_link('public/storage') || exit(pclose(popen(escapeshellarg(PHP_BINARY) . ' artisan storage:link --ansi', 'w')));\"",
            "npm ci",
            "npm run build"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "test:coverage": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "@php artisan config:clear --ansi",
            "@php artisan test --coverage --coverage-html=coverage"
        ],
        "lint:check": [
            "pint --test",
            "phpstan analyse --no-progress",
            "npm run lint"
        ],
        "lint:fix": [
            "pint",
            "npm run lint:fix",
            "phpstan analyse --no-progress"
        ]
    },
    "scripts-descriptions": {
        "setup": "Create .env if missing, install PHP and npm dependencies, generate APP_KEY if empty, link storage and build the frontend.",
        "test": "Run the test suite (SQLite in memory).",
        "test:coverage": "Run the test suite with a coverage summary and an HTML report in coverage/ (needs PCOV or Xdebug).",
        "lint:check": "Check PHP style (Pint), run static analysis (PHPStan) and lint JavaScript (ESLint) without changing files.",
        "lint:fix": "Fix PHP style (Pint) and JavaScript (ESLint --fix), then report what PHPStan still finds."
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
